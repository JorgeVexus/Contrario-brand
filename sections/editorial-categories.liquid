{%- liquid
  assign visible_count = 0
  for block in section.blocks
    assign card_link = block.settings.custom_link | default: block.settings.collection.url
    if card_link != blank or request.design_mode
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 or section.settings.heading != blank or section.settings.eyebrow != blank -%}
  {%- style -%}
    #EditorialCategories-{{ section.id }} {
      --editorial-bg: {{ section.settings.background_color }};
      --editorial-heading: {{ section.settings.heading_color }};
      --editorial-title: {{ section.settings.title_color }};
      --editorial-cta: {{ section.settings.cta_color }};
      --editorial-accent: {{ section.settings.accent_color }};
      --editorial-overlay: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
      --editorial-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      --editorial-brightness: {{ section.settings.image_brightness | divided_by: 100.0 }};
      --editorial-zoom: {{ section.settings.image_zoom | divided_by: 100.0 }};
      --editorial-title-size: {{ section.settings.title_size }}px;
      --editorial-title-size-mobile: {{ section.settings.title_size_mobile }}px;
      --editorial-cta-size: {{ section.settings.cta_size }}px;
      --editorial-card-height: {{ section.settings.desktop_card_height }}px;
      --editorial-card-height-mobile: {{ section.settings.mobile_card_height }}px;
      --editorial-content-inset: {{ section.settings.content_inset }}px;
      --editorial-column-gap: {{ section.settings.column_gap }}px;
      --editorial-row-gap: {{ section.settings.row_gap }}px;
      --editorial-mobile-gap: {{ section.settings.mobile_gap }}px;
      background: var(--editorial-bg);
      color: var(--editorial-heading);
      padding: {{ section.settings.padding_top }}px {{ section.settings.desktop_gutter }}px {{ section.settings.padding_bottom }}px;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__inner {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__header {
      margin-bottom: 28px;
      text-align: {{ section.settings.heading_alignment }};
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__eyebrow {
      margin: 0 0 8px;
      color: var(--editorial-accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__heading {
      margin: 0;
      color: var(--editorial-heading);
      font-size: clamp(28px, 3.2vw, 52px);
      font-weight: 700;
      line-height: .95;
      text-transform: uppercase;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--editorial-row-gap) var(--editorial-column-gap);
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__card {
      position: relative;
      display: block;
      min-width: 0;
      height: var(--editorial-card-height);
      overflow: hidden;
      color: inherit;
      background: #202020;
      text-decoration: none;
      isolation: isolate;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__media,
    #EditorialCategories-{{ section.id }} .editorial-categories__image,
    #EditorialCategories-{{ section.id }} .editorial-categories__placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__image,
    #EditorialCategories-{{ section.id }} .editorial-categories__placeholder {
      object-fit: cover;
      object-position: var(--desktop-focal-point);
      filter: brightness(var(--editorial-brightness)){% if section.settings.enable_grayscale %} grayscale(1){% endif %};
      transform: scale(1);
      transition: transform 550ms cubic-bezier(.2,.7,.2,1), filter 300ms ease;
      will-change: transform;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__overlay {
      position: absolute;
      z-index: 1;
      inset: 0;
      background: rgba(var(--editorial-overlay), var(--editorial-overlay-opacity));
      pointer-events: none;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__content {
      position: absolute;
      z-index: 2;
      right: var(--editorial-content-inset);
      bottom: var(--editorial-content-inset);
      left: var(--editorial-content-inset);
      text-align: {{ section.settings.content_alignment }};
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__title {
      display: block;
      margin: 0;
      color: var(--editorial-title);
      font-size: var(--editorial-title-size);
      font-weight: 800;
      line-height: .92;
      letter-spacing: -.035em;
      text-transform: uppercase;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      color: var(--editorial-cta);
      font-size: var(--editorial-cta-size);
      font-weight: 700;
      line-height: 1;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__cta::after {
      width: 28px;
      height: 2px;
      background: var(--editorial-accent);
      content: '';
      transition: width 250ms ease;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__card:hover .editorial-categories__image,
    #EditorialCategories-{{ section.id }} .editorial-categories__card:focus-visible .editorial-categories__image {
      transform: scale(var(--editorial-zoom));
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__card:hover .editorial-categories__cta::after,
    #EditorialCategories-{{ section.id }} .editorial-categories__card:focus-visible .editorial-categories__cta::after {
      width: 42px;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories__card:focus-visible {
      outline: 3px solid var(--editorial-accent);
      outline-offset: 3px;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-1 {
      grid-template-columns: minmax(0, 1fr);
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-1 .editorial-categories__card {
      height: calc(var(--editorial-card-height) * 1.12);
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-3 {
      grid-template-rows: repeat(2, var(--editorial-card-height));
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-3 .editorial-categories__card {
      height: var(--editorial-card-height);
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-3 .editorial-categories__card:first-child {
      grid-row: 1 / span 2;
      height: auto;
    }

    #EditorialCategories-{{ section.id }} .editorial-categories--count-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media screen and (max-width: 749px) {
      #EditorialCategories-{{ section.id }} {
        padding-right: {{ section.settings.mobile_gutter }}px;
        padding-left: {{ section.settings.mobile_gutter }}px;
      }

      #EditorialCategories-{{ section.id }} .editorial-categories__header {
        margin-bottom: 20px;
      }

      #EditorialCategories-{{ section.id }} .editorial-categories__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: none;
        gap: var(--editorial-mobile-gap);
      }

      #EditorialCategories-{{ section.id }} .editorial-categories__card,
      #EditorialCategories-{{ section.id }} .editorial-categories--count-1 .editorial-categories__card,
      #EditorialCategories-{{ section.id }} .editorial-categories--count-3 .editorial-categories__card,
      #EditorialCategories-{{ section.id }} .editorial-categories--count-3 .editorial-categories__card:first-child {
        grid-row: auto;
        height: var(--editorial-card-height-mobile);
      }

      #EditorialCategories-{{ section.id }} .editorial-categories__image,
      #EditorialCategories-{{ section.id }} .editorial-categories__placeholder {
        object-position: var(--mobile-focal-point);
      }

      #EditorialCategories-{{ section.id }} .editorial-categories__title {
        font-size: var(--editorial-title-size-mobile);
      }

      {%- if section.settings.mobile_rail -%}
        #EditorialCategories-{{ section.id }} .editorial-categories__grid {
          grid-auto-flow: column;
          grid-auto-columns: 86%;
          grid-template-columns: none;
          overflow-x: auto;
          overflow-y: hidden;
          scroll-snap-type: x mandatory;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        }

        #EditorialCategories-{{ section.id }} .editorial-categories__grid::-webkit-scrollbar {
          display: none;
        }

        #EditorialCategories-{{ section.id }} .editorial-categories__card {
          scroll-snap-align: start;
        }
      {%- endif -%}
    }

    @media (prefers-reduced-motion: reduce) {
      #EditorialCategories-{{ section.id }} .editorial-categories__image,
      #EditorialCategories-{{ section.id }} .editorial-categories__cta::after {
        transition: none;
      }
    }
  {%- endstyle -%}

  <section id="EditorialCategories-{{ section.id }}" class="editorial-categories">
    <div class="editorial-categories__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="editorial-categories__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="editorial-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="editorial-categories__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if visible_count > 0 -%}
        <div class="editorial-categories__grid editorial-categories--count-{{ visible_count }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_link = block.settings.custom_link | default: block.settings.collection.url
              assign card_image = block.settings.image | default: block.settings.collection.featured_image
              assign card_title = block.settings.title | default: block.settings.collection.title
              assign card_alt = block.settings.image_alt | default: card_image.alt | default: card_title
              if card_title == blank and request.design_mode
                assign card_title = 'Category'
              endif
            -%}
            {%- if card_link != blank or request.design_mode -%}
              <a
                class="editorial-categories__card"
                href="{{ card_link | default: '#' }}"
                style="--desktop-focal-point: {{ block.settings.desktop_focal_point }}; --mobile-focal-point: {{ block.settings.mobile_focal_point }};"
                {{ block.shopify_attributes }}
              >
                <span class="editorial-categories__media" aria-hidden="true">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 2200
                      | image_tag:
                        class: 'editorial-categories__image',
                        widths: '360, 540, 720, 900, 1200, 1600, 2200',
                        sizes: '(max-width: 749px) 86vw, 50vw',
                        loading: 'lazy',
                        alt: card_alt
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'editorial-categories__placeholder placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="editorial-categories__overlay" aria-hidden="true"></span>
                <span class="editorial-categories__content">
                  <span class="editorial-categories__title">{{ card_title | escape }}</span>
                  {%- if block.settings.cta_text != blank -%}
                    <span class="editorial-categories__cta">{{ block.settings.cta_text | escape }}</span>
                  {%- endif -%}
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p>Add a category block and select a collection to begin.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Editorial categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Section heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#111111" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "min": 800, "max": 1800, "step": 20, "unit": "px", "label": "Maximum width", "default": 1440 },
    { "type": "range", "id": "desktop_card_height", "min": 280, "max": 760, "step": 10, "unit": "px", "label": "Desktop card height", "default": 480 },
    { "type": "range", "id": "mobile_card_height", "min": 320, "max": 700, "step": 10, "unit": "px", "label": "Mobile card height", "default": 500 },
    { "type": "range", "id": "column_gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Column gap", "default": 16 },
    { "type": "range", "id": "row_gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Row gap", "default": 16 },
    { "type": "range", "id": "mobile_gap", "min": 8, "max": 32, "step": 2, "unit": "px", "label": "Mobile gap", "default": 12 },
    { "type": "checkbox", "id": "mobile_rail", "label": "Scrollable cards on mobile", "default": true },
    { "type": "range", "id": "desktop_gutter", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Desktop side spacing", "default": 24 },
    { "type": "range", "id": "mobile_gutter", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Mobile side spacing", "default": 16 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top spacing", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom spacing", "default": 64 },
    { "type": "header", "content": "Image treatment" },
    { "type": "checkbox", "id": "enable_grayscale", "label": "Black and white images", "default": true },
    { "type": "range", "id": "image_brightness", "min": 40, "max": 120, "step": 5, "unit": "%", "label": "Image brightness", "default": 85 },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 20 },
    { "type": "range", "id": "image_zoom", "min": 100, "max": 112, "step": 1, "unit": "%", "label": "Hover zoom", "default": 104 },
    { "type": "header", "content": "Card content" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#FFFFFF" },
    { "type": "range", "id": "title_size", "min": 24, "max": 72, "step": 2, "unit": "px", "label": "Desktop title size", "default": 42 },
    { "type": "range", "id": "title_size_mobile", "min": 22, "max": 52, "step": 2, "unit": "px", "label": "Mobile title size", "default": 34 },
    { "type": "color", "id": "cta_color", "label": "Link color", "default": "#C8FF00" },
    { "type": "range", "id": "cta_size", "min": 9, "max": 18, "step": 1, "unit": "px", "label": "Link size", "default": 11 },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C8FF00" },
    { "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "range", "id": "content_inset", "min": 12, "max": 64, "step": 4, "unit": "px", "label": "Content inset", "default": 24 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "cta_text", "label": "Link text", "default": "EXPLORE NOW" },
        { "type": "url", "id": "custom_link", "label": "Custom link" },
        { "type": "select", "id": "desktop_focal_point", "label": "Desktop focal point", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "select", "id": "mobile_focal_point", "label": "Mobile focal point", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial categories",
      "settings": { "enable_grayscale": true, "image_zoom": 104 },
      "blocks": [{ "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
