{{ 'section-hero-rebellion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign fetch_priority = 'auto'
  assign image_loading = 'lazy'
  if section.index == 1
    assign fetch_priority = 'high'
    assign image_loading = 'eager'
  endif
-%}

{%- style -%}
  #HeroRebellion-{{ section.id }} {
    --hero-rebellion-image-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="HeroRebellion-{{ section.id }}"
  class="hero-rebellion hero-rebellion--height-{{ section.settings.desktop_height }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="hero-rebellion__media">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 550 }} 550w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 3840
          | image_tag:
            class: 'hero-rebellion__image',
            widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
            sizes: '100vw',
            loading: image_loading,
            fetchpriority: fetch_priority,
            alt: section.settings.heading | escape
        }}
      </picture>
    {%- else -%}
      <img
        src="{{ 'rebellion-hero-bg.png' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        class="hero-rebellion__image"
        loading="{{ image_loading }}"
        fetchpriority="{{ fetch_priority }}"
        width="1920"
        height="1080"
      >
    {%- endif -%}
  </div>

  {%- if section.settings.show_gradient -%}
    <div class="hero-rebellion__gradient" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero-rebellion__content">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="hero-rebellion__heading">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="hero-rebellion__cta-wrap">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="hero-rebellion__cta-button"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Rebellion",
  "tag": "section",
  "class": "section-hero-rebellion",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Opacity",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Show Bottom Dark Gradient",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_height",
      "options": [
        {
          "value": "full",
          "label": "Full Screen (100vh)"
        },
        {
          "value": "large",
          "label": "Large (80vh)"
        },
        {
          "value": "medium",
          "label": "Medium (65vh)"
        }
      ],
      "default": "full",
      "label": "Section Height"
    },
    {
      "type": "header",
      "content": "Heading Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WEAR THE REBELLION"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "div",
          "label": "div"
        }
      ],
      "default": "h1",
      "label": "Heading HTML Tag"
    },
    {
      "type": "header",
      "content": "Call to Action Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero Rebellion"
    }
  ]
}
{% endschema %}
