{{ 'section-cta-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign fetch_priority = 'auto'
  assign image_loading = 'lazy'
  if section.index == 1
    assign fetch_priority = 'high'
    assign image_loading = 'eager'
  endif
-%}

{%- style -%}
  #CtaBanner-{{ section.id }} {
    --cta-subheading-size: {{ section.settings.subheading_size }}px;
    --cta-subheading-color: {{ section.settings.subheading_color }};
    --cta-heading-size: {{ section.settings.heading_size }}px;
    --cta-heading-color: {{ section.settings.heading_color }};
    --cta-description-size: {{ section.settings.description_size }}px;
    --cta-description-color: {{ section.settings.description_color }};
    --cta-overlay-color: {{ section.settings.overlay_color }};
    --cta-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cta-btn1-bg: {{ section.settings.button_1_bg_color }};
    --cta-btn1-color: {{ section.settings.button_1_text_color }};
    --cta-btn2-bg: {{ section.settings.button_2_bg_color }};
    --cta-btn2-color: {{ section.settings.button_2_text_color }};
    --cta-border-radius: {{ section.settings.border_radius }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="CtaBanner-{{ section.id }}"
  class="cta-banner-section{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="cta-banner-container cta-banner-container--{{ section.settings.container_width }}">
    <div class="cta-banner-card cta-banner-card--height-{{ section.settings.image_height }}">
      
      <!-- Background Media -->
      <div class="cta-banner-media">
        {%- if desktop_image != blank -%}
          <picture>
            {%- if section.settings.image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ mobile_image | image_url: width: 375 }} 375w,
                  {{ mobile_image | image_url: width: 550 }} 550w,
                  {{ mobile_image | image_url: width: 750 }} 750w,
                  {{ mobile_image | image_url: width: 1100 }} 1100w
                "
                sizes="100vw"
              >
            {%- endif -%}
            {{
              desktop_image
              | image_url: width: 3840
              | image_tag:
                class: 'cta-banner-image',
                widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
                sizes: '100vw',
                loading: image_loading,
                fetchpriority: fetch_priority,
                alt: section.settings.heading | escape
            }}
          </picture>
        {%- else -%}
          <div class="cta-banner-fallback-bg"></div>
        {%- endif -%}
      </div>

      <!-- Overlay Layer -->
      <div
        class="cta-banner-overlay{% if section.settings.overlay_gradient %} cta-banner-overlay--gradient{% endif %}"
        aria-hidden="true"
      ></div>

      <!-- Content Wrap -->
      <div class="cta-banner-content-wrap cta-banner-content-wrap--pos-{{ section.settings.content_position }}">
        <div class="cta-banner-box cta-banner-box--align-{{ section.settings.content_alignment }}">
          
          {%- if section.settings.subheading != blank -%}
            <p class="cta-banner-subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="cta-banner-heading">
              {{ section.settings.heading | escape }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="cta-banner-description">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
            <div class="cta-banner-buttons">
              {%- if section.settings.button_1_text != blank -%}
                <a
                  href="{{ section.settings.button_1_link | default: '#' }}"
                  class="cta-btn cta-btn--primary cta-btn--{{ section.settings.button_1_style }}"
                >
                  <span>{{ section.settings.button_1_text | escape }}</span>
                  {%- if section.settings.button_1_icon -%}
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- endif -%}
                </a>
              {%- endif -%}

              {%- if section.settings.button_2_text != blank -%}
                <a
                  href="{{ section.settings.button_2_link | default: '#' }}"
                  class="cta-btn cta-btn--secondary cta-btn--{{ section.settings.button_2_style }}"
                >
                  <span>{{ section.settings.button_2_text | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner CTA",
  "tag": "section",
  "class": "section-cta-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido de Texto"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "VENTA POR MAYOREO"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtítulo (px)",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtítulo",
      "default": "#ffeb3b"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título principal",
      "default": "Importamos lo que necesitas"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del título (px)",
      "default": 42
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Etiqueta HTML del título",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Párrafo"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción / Texto",
      "default": "<p>Abastece tu negocio con los mejores precios de mayoreo directamente desde fábrica. Calidad garantizada y envíos a todo el país.</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de descripción (px)",
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de descripción",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Imagen de Fondo & Overlay"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen para escritorio"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen para móvil"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Altura de la sección",
      "options": [
        {
          "value": "small",
          "label": "Pequeña (350px)"
        },
        {
          "value": "medium",
          "label": "Mediana (500px)"
        },
        {
          "value": "large",
          "label": "Grande (650px)"
        },
        {
          "value": "full",
          "label": "Pantalla Completa"
        },
        {
          "value": "adapt",
          "label": "Adaptar a imagen"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color de capa superpuesta",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad de la capa (%)",
      "default": 55
    },
    {
      "type": "checkbox",
      "id": "overlay_gradient",
      "label": "Degradado en la capa",
      "default": true
    },
    {
      "type": "header",
      "content": "Botones de Acción"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Texto del botón principal",
      "default": "Ver Catálogo Mayorista"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Enlace del botón principal"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Estilo del botón principal",
      "options": [
        {
          "value": "solid",
          "label": "Relleno Sólido"
        },
        {
          "value": "outline",
          "label": "Borde (Outline)"
        },
        {
          "value": "glass",
          "label": "Efecto Cristal (Glass)"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "button_1_bg_color",
      "label": "Color de fondo del botón",
      "default": "#005bd3"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Color de texto del botón",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "button_1_icon",
      "label": "Mostrar flecha en botón",
      "default": true
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Texto del segundo botón",
      "default": "Contactar Asesor"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Enlace del segundo botón"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Estilo del segundo botón",
      "options": [
        {
          "value": "outline",
          "label": "Borde (Outline)"
        },
        {
          "value": "solid",
          "label": "Relleno Sólido"
        },
        {
          "value": "glass",
          "label": "Efecto Cristal (Glass)"
        }
      ],
      "default": "outline"
    },
    {
      "type": "color",
      "id": "button_2_bg_color",
      "label": "Fondo del 2do botón",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Texto del 2do botón",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Diseño y Alineación"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
