        },
        {
          "value": "top-left",
          "label": "Superior Izquierda"
        },
        {
          "value": "bottom-left",
          "label": "Inferior Izquierda"
        },
        {
          "value": "bottom-center",
          "label": "Inferior Centro"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Ancho del contenedor",
      "options": [
        {
          "value": "full_width",
          "label": "Ancho completo"
        },
        {
          "value": "contained",
          "label": "Contenido en caja"
        },
        {
          "value": "narrow_card",
          "label": "Caja estrecha"
        }
      ],
      "default": "contained"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Radio de bordes (px)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior (px)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior (px)",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Banner CTA",
      "settings": {
        "subheading": "VENTA POR MAYOREO",
        "heading": "Importamos lo que necesitas",
        "description": "<p>Abastece tu negocio con los mejores precios de mayoreo directamente desde fábrica. Envíos garantizados a todo el país.</p>",
        "button_1_text": "Ver Catálogo Mayorista",
        "button_1_link": "shopify://collections/all",
        "button_2_text": "Contactar Asesor",
        "content_alignment": "center",
        "content_position": "center",
