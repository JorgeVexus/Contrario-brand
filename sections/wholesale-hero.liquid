{{ 'section-wholesale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #WholesaleHero-{{ section.id }} {
    --ws-hero-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="WholesaleHero-{{ section.id }}"
  class="wholesale-hero {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  data-analytics-section="wholesale_hero"
>
  <div class="wholesale-hero__bg-wrap">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
            sizes="100vw"
          >
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag:
            class: 'wholesale-hero__image',
            widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.heading | escape
        }}
      </picture>
    {%- else -%}
      <div class="wholesale-hero__image" style="background: radial-gradient(circle at 60% 40%, #1c1c1e 0%, #080808 80%);"></div>
    {%- endif -%}
    <div class="wholesale-hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="ws-container wholesale-hero__content-wrap">
    <div class="wholesale-hero__main">
      <div class="wholesale-hero__meta-bar">
        <div class="ws-badge">
          <span class="ws-badge__dot ws-badge__dot--pulse"></span>
          <span>{{ section.settings.badge_text | default: 'B2B Wholesale' }}</span>
        </div>
        <span class="wholesale-hero__coord">{{ section.settings.coordinates_text | default: '[WDC // 38.9072° N, 77.0369° W]' }}</span>
      </div>

      <h1 class="wholesale-hero__heading">
        {{ section.settings.heading | default: 'STOCK CONTRARIO' }}
      </h1>

      {%- if section.settings.subtext != blank -%}
        <div class="wholesale-hero__subtext">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}

      <div class="wholesale-hero__actions">
        {%- if section.settings.primary_button_label != blank -%}
          <a
            href="{{ section.settings.primary_button_link | default: '#wholesale-apply' }}"
            class="ws-btn ws-btn--primary"
            data-analytics-event="wholesale_apply_click"
          >
            {{ section.settings.primary_button_label }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_label != blank -%}
          <a
            href="{{ section.settings.secondary_button_link | default: '#wholesale-linesheet' }}"
            class="ws-btn ws-btn--secondary"
            data-analytics-event="wholesale_linesheet_click"
          >
            {{ section.settings.secondary_button_label }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.5 6H9.5M9.5 6L6 2.5M9.5 6L6 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="wholesale-hero__ticker">
      <div class="ws-container" style="padding:0;">
        <div class="wholesale-hero__ticker-grid">
          {%- for block in section.blocks -%}
            <div class="wholesale-hero__ticker-item" {{ block.shopify_attributes }}>
              <span class="wholesale-hero__ticker-label">{{ block.settings.label }}</span>
              <span class="wholesale-hero__ticker-value">{{ block.settings.value }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Wholesale Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Hero Image Mobile"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Opacity",
      "default": 45
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "B2B WHOLESALE // STOCK CONTRARIO"
    },
    {
      "type": "text",
      "id": "coordinates_text",
      "label": "Location Tag",
      "default": "[WDC // 38.9072° N, 77.0369° W]"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "STOCK CONTRARIO"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext Description",
      "default": "<p>Exclusive B2B partnership for boutiques, concept stores, and global fashion retailers. Distinctive brutalist silhouettes, limited capsule runs.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary Button Label",
      "default": "APPLY FOR WHOLESALE"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "REQUEST LINE SHEET"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Metric Label",
          "default": "MINIMUM ORDER"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Metric Value",
          "default": "$1,500 USD / MIXED"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale Hero",
      "blocks": [
        {
          "type": "metric",
          "settings": {
            "label": "OPENING ORDER",
            "value": "$1,500 USD"
          }
        },
        {
          "type": "metric",
          "settings": {
            "label": "FULFILLMENT",
            "value": "DC & CDMX HUBS"
          }
        },
        {
          "type": "metric",
          "settings": {
            "label": "PRODUCTION",
            "value": "LIMITED CAPSULES"
          }
        },
        {
          "type": "metric",
          "settings": {
            "label": "DISTRIBUTION",
            "value": "SELECT BOUTIQUES"
          }
        }
      ]
    }
  ]
}
{% endschema %}
