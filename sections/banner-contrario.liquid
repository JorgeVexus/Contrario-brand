{{ 'section-banner-contrario.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: desktop_image
  assign fetch_priority = 'auto'
  assign image_loading = 'lazy'
  if section.index == 1
    assign fetch_priority = 'high'
    assign image_loading = 'eager'
  endif
-%}

{%- style -%}
  #BannerContrario-{{ section.id }} {
    --banner-contrario-image-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    --banner-contrario-overlay-color: {{ section.settings.overlay_color }};
    --banner-contrario-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --banner-contrario-subheading-size: {{ section.settings.subheading_size }}px;
    --banner-contrario-subheading-color: {{ section.settings.subheading_color }};
    --banner-contrario-heading-size: {{ section.settings.heading_size }}px;
    --banner-contrario-heading-color: {{ section.settings.heading_color }};
    --banner-contrario-description-size: {{ section.settings.description_size }}px;
    --banner-contrario-description-color: {{ section.settings.description_color }};
    --banner-contrario-btn-bg: {{ section.settings.button_bg_color }};
    --banner-contrario-btn-color: {{ section.settings.button_text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="BannerContrario-{{ section.id }}"
  class="banner-contrario banner-contrario--height-{{ section.settings.desktop_height }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <!-- Background Media -->
  <div class="banner-contrario__media">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 375 }} 375w,
              {{ mobile_image | image_url: width: 550 }} 550w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 3840
          | image_tag:
            class: 'banner-contrario__image',
            widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
            sizes: '100vw',
            loading: image_loading,
            fetchpriority: fetch_priority,
            alt: section.settings.heading | escape
        }}
      </picture>
    {%- else -%}
      <div class="banner-contrario__fallback-media"></div>
    {%- endif -%}
  </div>

  <!-- Overlay & Gradient -->
  <div class="banner-contrario__overlay" aria-hidden="true"></div>

  {%- if section.settings.show_gradient -%}
    <div class="banner-contrario__gradient" aria-hidden="true"></div>
  {%- endif -%}

  <!-- Content Box -->
  <div class="banner-contrario__content banner-contrario__content--align-{{ section.settings.content_alignment }}">
    
    {%- if section.settings.subheading != blank -%}
      <p class="banner-contrario__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="banner-contrario__heading">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="banner-contrario__description">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="banner-contrario__cta-wrap">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="banner-contrario__cta-button banner-contrario__cta-button--{{ section.settings.button_style }}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Banner Contrario CTA",
  "tag": "section",
  "class": "section-banner-contrario",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contenido de Texto"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo / Línea 1"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño del subtítulo (px)",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtítulo",
      "default": "#a0a0a0"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título principal / Texto CTA",
      "default": "CONTRARIO\nZERO AGE LIMIT.\nMAXIMUM PERSONALITY"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Tamaño del título (px)",
      "default": 72
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Etiqueta HTML del título",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Párrafo"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción / Texto secundario"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de descripción (px)",
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de descripción",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Imagen de Fondo & Overlay"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo (Escritorio)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen de fondo (Móvil)"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad de imagen (%)",
      "default": 80
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Color de capa superpuesta",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacidad de la capa (%)",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Mostrar degradado inferior",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Altura de la sección",
      "options": [
        {
          "value": "full",
          "label": "Pantalla Completa (100vh)"
        },
        {
          "value": "large",
          "label": "Grande (80vh)"
        },
        {
          "value": "medium",
          "label": "Mediana (65vh)"
        },
        {
          "value": "small",
          "label": "Pequeña (450px)"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Botón de Acción"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        {
          "value": "solid",
          "label": "Relleno Sólido"
        },
        {
          "value": "outline",
          "label": "Borde (Outline)"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Color de fondo del botón",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color del texto del botón",
      "default": "#131313"
    },
    {
      "type": "header",
      "content": "Diseño y Alineación"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior (px)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior (px)",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Banner Contrario CTA",
      "settings": {
        "heading": "CONTRARIO\nZERO AGE LIMIT.\nMAXIMUM PERSONALITY",
        "heading_size": 72,
        "heading_color": "#ffffff",
        "button_label": "SHOP NOW",
        "button_link": "shopify://collections/all",
        "button_bg_color": "#ffffff",
        "button_text_color": "#131313",
        "desktop_height": "full",
        "content_alignment": "center",
        "show_gradient": true
      }
    }
  ]
}
{% endschema %}
