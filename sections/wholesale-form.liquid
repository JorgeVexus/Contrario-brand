        {
          "value": "light-alt",
          "label": "Soft Off-White Light"
        },
        {
          "value": "dark",
          "label": "Noir Obsidian Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "text",
      "id": "sidebar_tag",
      "label": "Sidebar Tag",
      "default": "// B2B PARTNERSHIP INTAKE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "APPLY FOR WHOLESALE ACCOUNT"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section Description",
      "default": "We review boutique applications within 24 to 48 business hours. Once verified, you will receive our wholesale linesheet, lookbook, and direct order access."
    },
    {
      "type": "text",
      "id": "perk_1_title",
      "label": "Perk 1 Title",
      "default": "PRIVATE LINESHEET ACCESS"
    },
    {
      "type": "text",
      "id": "perk_1_desc",
      "label": "Perk 1 Description",
      "default": "Wholesale tiered pricing, SKU breakdowns, and fabric weight specifications."
    },
    {
      "type": "text",
      "id": "perk_2_title",
      "label": "Perk 2 Title",
      "default": "PRIORITY ALLOCATION"
    },
    {
      "type": "text",
      "id": "perk_2_desc",
      "label": "Perk 2 Description",
      "default": "Guaranteed inventory reservation before public direct-to-consumer drops."
    },
    {
      "type": "text",
      "id": "perk_3_title",
      "label": "Perk 3 Title",
      "default": "DIRECT ACCOUNT LIAISON"
    },
    {
      "type": "text",
      "id": "perk_3_desc",
      "label": "Perk 3 Description",
      "default": "Dedicated representative for rapid replenishment and custom merchandising."
    },
    {
      "type": "text",
      "id": "submit_button_label",
      "label": "Submit Button Label",
      "default": "SUBMIT WHOLESALE APPLICATION"
    },
    {
      "type": "text",
      "id": "confidentiality_note",
      "label": "Confidentiality Note",
      "default": "All retailer submissions are held confidential. Wholesale pricing is disclosed only to verified trade accounts."
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success Title",
      "default": "APPLICATION RECEIVED"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Our wholesale team has received your details. We will review your store credentials and send our linesheet & pricing packet within 24-48 hours."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Wholesale Form"
    }
  ]
}
{% endschema %}
