{{ 'section-wholesale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #WholesaleProgram-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="WholesaleProgram-{{ section.id }}"
  class="wholesale-program ws-theme--{{ section.settings.color_scheme | default: 'dark' }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  data-analytics-section="wholesale_terms_program"
>
  <div class="ws-container">
    <div class="ws-section-header">
      <span class="ws-section-tag">{{ section.settings.tagline | default: '// COMMERCIAL TERMS & POLICIES' }}</span>
      <h2 class="ws-section-title">{{ section.settings.heading | default: 'THE WHOLESALE PROGRAM' }}</h2>
      <p class="ws-section-desc">
        {{ section.settings.description | default: 'Engineered for seamless retailer partnerships. Clear minimums, agile reorder turnarounds, and direct fulfillment.' }}
      </p>
    </div>

    <div class="wholesale-program__bento">
      {%- for block in section.blocks -%}
        <div class="ws-bento-card {% if block.settings.highlight %}ws-bento-card--highlight{% endif %}" {{ block.shopify_attributes }}>
          <div class="ws-bento-card__head">
            <span class="ws-bento-card__tag">{{ block.settings.tag | default: 'SPEC' }}</span>
            <span class="ws-bento-card__icon">
              {%- case block.type -%}
                {%- when 'opening_order' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                {%- when 'sizing' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                {%- when 'lead_time' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {%- when 'reorders' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                {%- when 'shipping' -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- else -%}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- endcase -%}
            </span>
          </div>
          <div>
            {%- if block.settings.metric != blank -%}
              <div class="ws-bento-card__metric">{{ block.settings.metric }}</div>
            {%- endif -%}
            <h3 class="ws-bento-card__title">{{ block.settings.title }}</h3>
            <p class="ws-bento-card__desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale Program",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        {
          "value": "dark",
          "label": "Noir Obsidian Dark (Featured)"
        },
        {
          "value": "light",
          "label": "White Clean Light"
        },
        {
          "value": "light-alt",
          "label": "Soft Off-White Light"
        }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "tagline",
